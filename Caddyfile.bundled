# Single listener on $PORT with host-based routing (Render and local dev).
# Env vars are exported by start-bundled.sh before caddy run.
#
#   SITE_HOST     → nginx (live published pages)
#   EDITOR_HOST   → Open WebUI
#   PREVIEW_HOST  → cms-api preview vhost (drafts)

:{$PORT} {
	@preview host {$PREVIEW_HOST}
	handle @preview {
		reverse_proxy 127.0.0.1:{$CMS_API_PORT}
	}

	@editor host {$EDITOR_HOST}
	handle @editor {
		reverse_proxy 127.0.0.1:{$WEBUI_PORT}
	}

	@site host {$SITE_HOST}
	handle @site {
		reverse_proxy 127.0.0.1:{$NGINX_PORT}
	}

	handle {
		respond 404
	}
}
