# Local multi-service stack — HTTP only on :8080 (no TLS / ACME).
# Mounted by docker-compose.local.yml into edge-router.

{
	email {$ACME_EMAIL}
	acme_ca https://acme-v02.api.letsencrypt.org/directory
}

http://{$SITE_HOST}:8080, http://www.{$SITE_HOST}:8080 {
	reverse_proxy nginx:80 {
		header_up -Cookie
	}
}

http://{$EDITOR_HOST}:8080 {
	reverse_proxy openwebui:8080
}

http://{$PREVIEW_HOST}:8080 {
	handle /api {
		respond 403
	}
	handle /api/* {
		respond 403
	}
	handle /openapi.json {
		respond 403
	}
	handle /mcp {
		respond 403
	}
	handle /mcp/* {
		respond 403
	}
	reverse_proxy cms-api:3000 {
		header_up -Cookie
	}
}

http://{$CONSOLE_HOST}:8080 {
	reverse_proxy cms-console:3000 {
		header_up X-Auth-Request-Email "dev@localhost"
		header_up X-Auth-Request-User "dev"
		header_up X-Auth-Request-Groups "console"
	}
}
