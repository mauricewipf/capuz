FROM oven/bun:1-alpine

WORKDIR /app

ARG COMMIT_SHA=
ARG BUILD_TIME=
ENV COMMIT_SHA=${COMMIT_SHA}
ENV BUILD_TIME=${BUILD_TIME}

COPY api/package.json api/bun.lock ./
RUN bun install --frozen-lockfile --production

COPY api/src ./src

ENV API_PORT=3000
ENV DATA_ROOT=/app/data

EXPOSE 3000

CMD ["bun", "run", "src/server.js"]
