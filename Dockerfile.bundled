FROM openwebui/open-webui:latest

USER root

RUN apt-get update \
  && apt-get install -y --no-install-recommends curl ca-certificates wget unzip nginx \
  && curl -fsSL https://bun.sh/install | bash \
  && apt-get install -y --no-install-recommends caddy \
  && rm -rf /var/lib/apt/lists/*

ENV PATH="/root/.bun/bin:${PATH}" \
  API_PORT=3000 \
  CMS_API_PORT=3000 \
  WEBUI_PORT=8080 \
  NGINX_PORT=8088 \
  DATA_ROOT=/app/data \
  STORAGE_BACKEND=fs \
  DRAFTS_DIR=.drafts \
  COMPONENTS_DIR=.components

ARG COMMIT_SHA=
ARG BUILD_TIME=
ENV COMMIT_SHA=${COMMIT_SHA}
ENV BUILD_TIME=${BUILD_TIME}

WORKDIR /app/cms-api
COPY api/package.json api/bun.lock ./
RUN bun install --frozen-lockfile --production
COPY api/src ./src

COPY public/ /app/seed/
COPY seed-data.sh /app/seed-data.sh
RUN chmod +x /app/seed-data.sh

COPY nginx.bundled.conf /etc/nginx/nginx.bundled.conf
COPY start-bundled.sh /start-bundled.sh
RUN chmod +x /start-bundled.sh

EXPOSE 10000

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider "http://127.0.0.1:${PORT:-10000}/" || exit 1

ENTRYPOINT ["/start-bundled.sh"]
