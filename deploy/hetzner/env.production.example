# Production env for Hetzner VPS (copy to deploy/hetzner/.env.production locally, then upload).
# Deploys the multi-service stack: docker-compose.yml + docker-compose.production.yml

OPENROUTER_API_KEY=sk-or-v1-...

CMS_API_KEY=
WEBUI_SECRET_KEY=

STORAGE_BACKEND=fs
DATA_ROOT=/app/data
DATA_DIR=/app/data/.open-webui
DRAFTS_DIR=.drafts
COMPONENTS_DIR=.components

# nginx seed: SKIP (empty live site) | SEED | FORCE_OVERWRITE (wipe assets, copy public/)
CAPUZ_SEED=SKIP

SITE_HOST=just-html.com
EDITOR_HOST=chat.just-html.com
PREVIEW_HOST=preview.just-html.com
CONSOLE_HOST=console.just-html.com
SITE_BASE_URL=https://just-html.com
WEBUI_URL=https://chat.just-html.com
PREVIEW_BASE_URL=https://preview.just-html.com

# GitHub OAuth (oauth2-proxy) — required for production chat + console
AUTH_HOST=auth.just-html.com
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_ALLOWED_USERS=your-github-login
# Exactly 16, 24, or 32 bytes — e.g. openssl rand -hex 16
OAUTH2_PROXY_COOKIE_SECRET=...   # openssl rand -hex 16
OAUTH2_PROXY_COOKIE_DOMAIN=.just-html.com
OAUTH2_PROXY_WHITELIST_DOMAIN=.just-html.com
CONSOLE_CSRF_SECRET=...     # openssl rand -hex 32
# Optional second restriction on console routes (empty = any allowlisted GitHub user)
CONSOLE_ALLOWED_GROUPS=

# Let's Encrypt contact for edge-router (required)
ACME_EMAIL=maurice.wipf@mauwi.me

ENABLE_SIGNUP=false
ENABLE_OPENAI_API=true
OPENAI_API_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_MODELS=minimax/minimax-m3
DEFAULT_MODEL_PARAMS={"function_calling":"native"}
RAG_EMBEDDING_ENGINE=openai

# Open WebUI — lean config (lower RAM on small VPS)
ENABLE_PERSISTENT_CONFIG=false
ENABLE_OLLAMA_API=false
ENABLE_WEB_SEARCH=false
ENABLE_CODE_EXECUTION=false
ENABLE_CODE_INTERPRETER=false
ENABLE_MEMORIES=false
ENABLE_MEMORY_SYSTEM_CONTEXT=false
ENABLE_MEMORY_BACKGROUND_REVIEW=false
ENABLE_AUTOMATIONS=false
ENABLE_NOTES=false
ENABLE_CALENDAR=false
ENABLE_CHANNELS=false
ENABLE_TITLE_GENERATION=false
ENABLE_FOLLOW_UP_GENERATION=false
ENABLE_TAGS_GENERATION=false
ENABLE_AUTOCOMPLETE_GENERATION=false
ENABLE_EVALUATION_ARENA_MODELS=false
ENABLE_COMMUNITY_SHARING=false
ENABLE_REALTIME_CHAT_SAVE=false
GLOBAL_LOG_LEVEL=WARNING
ENABLE_AUDIT_LOGS_FILE=false
