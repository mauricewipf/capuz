# Production env for Hetzner VPS (copy to deploy/hetzner/.env.production locally, then upload to the server).
# Generate secrets:
#   openssl rand -hex 32   # CMS_API_KEY and WEBUI_SECRET_KEY

OPENROUTER_API_KEY=sk-or-v1-...

CMS_API_KEY=
WEBUI_SECRET_KEY=

STORAGE_BACKEND=fs
DATA_ROOT=/app/data
DRAFTS_DIR=.drafts
COMPONENTS_DIR=.components

# Replace just-html.com with your domain
SITE_HOST=just-html.com
EDITOR_HOST=chat.just-html.com
PREVIEW_HOST=preview.just-html.com
SITE_BASE_URL=https://just-html.com
WEBUI_URL=https://chat.just-html.com
PREVIEW_BASE_URL=https://preview.just-html.com

PORT=8081
ENABLE_SIGNUP=false
ENABLE_OPENAI_API=true
OPENAI_API_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_MODELS=minimax/minimax-m3
DEFAULT_MODEL_PARAMS={"function_calling":"native"}
RAG_EMBEDDING_ENGINE=openai
