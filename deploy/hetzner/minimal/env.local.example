# Local editor stack — Open WebUI + cms-api on your machine;
# live pages on Hetzner via SFTP (STORAGE_BACKEND=sftp) over Tailscale.
#
#   cp deploy/hetzner/minimal/env.local.example .env
#   # edit secrets, SFTP_HOST (Tailscale MagicDNS), SFTP_KEY_HOST_PATH
#   docker compose -f docker-compose.stack.yml -f docker-compose.stack.sftp.yml up --build
#
# Open WebUI: http://localhost:8081
# Preview:    http://preview.localhost:8081
# Live site:  SITE_BASE_URL (nginx on the VPS)

OPENROUTER_API_KEY=sk-or-v1-...

CMS_API_KEY=
WEBUI_SECRET_KEY=

# SFTP → Hetzner (prefer Tailscale MagicDNS, not the public IP)
STORAGE_BACKEND=sftp
SFTP_HOST=capuz.tailnet-name.ts.net
SFTP_PORT=22
SFTP_USER=root
SFTP_REMOTE_ROOT=/opt/capuz/site-data
SFTP_KEY_HOST_PATH=/Users/YOU/.ssh/capuz_hetzner_sftp
SFTP_KEY_PATH=/keys/id_ed25519

DRAFTS_DIR=.drafts
COMPONENTS_DIR=.components

# Local preview only (not public)
PREVIEW_HOST=preview.localhost
PREVIEW_BASE_URL=http://preview.localhost:8081
SITE_BASE_URL=https://YOUR_DOMAIN

PORT=8081
WEBUI_URL=http://localhost:8081
ENABLE_SIGNUP=false
ENABLE_OPENAI_API=true
OPENAI_API_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_MODELS=minimax/minimax-m3
DEFAULT_MODEL_PARAMS={"function_calling":"native"}
RAG_EMBEDDING_ENGINE=openai

# Open WebUI — lean config
ENABLE_PERSISTENT_CONFIG=false
ENABLE_OLLAMA_API=false
ENABLE_WEB_SEARCH=false
ENABLE_CODE_EXECUTION=false
ENABLE_CODE_INTERPRETER=false
ENABLE_MEMORIES=false
ENABLE_MEMORY_SYSTEM_CONTEXT=false
ENABLE_MEMORY_BACKGROUND_REVIEW=false
ENABLE_AUTOMATIONS=false
ENABLE_NOTES=false
ENABLE_CALENDAR=false
ENABLE_CHANNELS=false
ENABLE_TITLE_GENERATION=false
ENABLE_FOLLOW_UP_GENERATION=false
ENABLE_TAGS_GENERATION=false
ENABLE_AUTOCOMPLETE_GENERATION=false
ENABLE_EVALUATION_ARENA_MODELS=false
ENABLE_COMMUNITY_SHARING=false
ENABLE_REALTIME_CHAT_SAVE=false
GLOBAL_LOG_LEVEL=WARNING
ENABLE_AUDIT_LOGS_FILE=false
