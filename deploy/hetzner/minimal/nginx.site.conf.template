# Native nginx site for Capuz minimal Hetzner deploy.
# Placeholders __SITE_DOMAIN__ and __SITE_ROOT__ are replaced by setup-server.sh.
# Certbot adds listen 443 / SSL directives after first run — do not overwrite
# sites-available with this file on an already-provisioned host without
# re-running certbot (or merging SSL blocks back in).

server {
    listen 80;
    listen [::]:80;
    server_name __SITE_DOMAIN__ www.__SITE_DOMAIN__;

    root __SITE_ROOT__;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/xml;

    location ~ /\. {
        deny all;
        return 404;
    }

    # Assets must 404 when missing — do not fall back to index.html (that makes
    # broken <img> requests look like successful HTML responses).
    location /assets/ {
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ $uri.html =404;
    }
}
